# Supabase project settings -> Data API / API Keys
# Both are safe to expose to the browser: access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional. Canonical origin used in the links Supabase emails.
# Leave unset locally (the request host is used) and on Vercel (the project's
# production domain is picked up automatically). Set it when serving from a
# custom domain that Vercel does not report as the production URL.
# NEXT_PUBLIC_SITE_URL=https://wild-hunt.example.com
